<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Compose Coffee</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            main: '#fdd22c',
            'main-dull': '#e3b609',
            'main-duller': '#ee9b00',
            'main-text': '#2e2726',
          },
          fontFamily: {
            sans: ['Quicksand', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="min-h-screen bg-gradient-to-br from-main-text via-gray-900 to-main-text flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-2xl shadow-xl p-8 md:p-10">
      <!-- Logo Header -->
      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-main/20 rounded-2xl mb-4">
          <i class="bi bi-cup-hot-fill text-3xl text-main-dull"></i>
        </div>
        <h1 class="text-2xl font-bold text-main-text">Compose Coffee</h1>
        <p class="text-gray-500 text-sm mt-1">Create Admin Account</p>
      </div>

      <!-- Error Alert -->
      <% if (error) { %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl">
          <p class="text-red-600 text-sm font-medium">
            <% if (error === 'signup_failed') { %>
              Failed to create admin account. Please try again.
            <% } else { %>
              An error occurred. Please try again.
            <% } %>
          </p>
        </div>
      <% } %>

      <!-- Signup Form -->
      <form action="/admin/signup" method="POST" enctype="multipart/form-data" class="space-y-4">
        <div>
          <label for="userNick" class="block text-sm font-medium text-gray-700 mb-2">Username *</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
              <i class="bi bi-person"></i>
            </span>
            <input
              type="text"
              id="userNick"
              name="userNick"
              placeholder="Choose a username"
              required
              class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl text-gray-700 placeholder-gray-400 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all"
            >
          </div>
        </div>

        <div>
          <label for="userEmail" class="block text-sm font-medium text-gray-700 mb-2">Email *</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
              <i class="bi bi-envelope"></i>
            </span>
            <input
              type="email"
              id="userEmail"
              name="userEmail"
              placeholder="admin@compose.coffee"
              required
              class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl text-gray-700 placeholder-gray-400 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all"
            >
          </div>
        </div>

        <div>
          <label for="userPhone" class="block text-sm font-medium text-gray-700 mb-2">Phone *</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
              <i class="bi bi-phone"></i>
            </span>
            <input
              type="text"
              id="userPhone"
              name="userPhone"
              placeholder="000-000-0000"
              required
              class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl text-gray-700 placeholder-gray-400 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all"
            >
          </div>
        </div>

        <div>
          <label for="userPassword" class="block text-sm font-medium text-gray-700 mb-2">Password *</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
              <i class="bi bi-lock"></i>
            </span>
            <input
              type="password"
              id="userPassword"
              name="userPassword"
              placeholder="Choose a strong password"
              required
              minlength="6"
              class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl text-gray-700 placeholder-gray-400 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all"
            >
          </div>
        </div>

        <div>
          <label for="userImage" class="block text-sm font-medium text-gray-700 mb-2">Profile Image</label>
          <input
            type="file"
            id="userImage"
            name="userImage"
            accept="image/*"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-main/20 file:text-main-text hover:file:bg-main/30 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all"
          >
          <p class="text-xs text-gray-500 mt-1">Optional. Max 10MB (JPEG, PNG, WEBP)</p>
        </div>

        <button
          type="submit"
          class="w-full py-3 px-4 bg-main text-main-text font-bold rounded-xl border-2 border-main-dull hover:bg-main-dull transition-all duration-200 flex items-center justify-center gap-2 shadow-sm hover:shadow-md mt-6"
        >
          <i class="bi bi-person-plus"></i>
          Create Account
        </button>
      </form>

      <!-- Back to Login Link -->
      <div class="mt-6 text-center">
        <a
          href="/admin/login"
          class="inline-flex items-center gap-2 text-gray-500 hover:text-main-text transition-colors text-sm"
        >
          <i class="bi bi-arrow-left"></i>
          Back to Login
        </a>
      </div>
    </div>

    <!-- Footer -->
    <p class="text-center text-gray-400 text-xs mt-6">
      &copy; <%= new Date().getFullYear() %> Compose Coffee. All rights reserved.
    </p>
  </div>
</body>
</html>
