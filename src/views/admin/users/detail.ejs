<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Compose Coffee Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/admin/css/admin.css">
</head>
<body>
  <div class="wrapper">
    <%- include('../partials/sidebar', { activePage }) %>
    <div class="main-content">
      <%- include('../partials/header', { user, title }) %>
      <main class="content">
        <% if (success) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            User updated successfully!
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <div class="d-flex justify-content-between align-items-center mb-4">
          <a href="/admin/users" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Users
          </a>
          <span class="badge bg-<%= userData.userStatus === 'ACTIVE' ? 'success' : userData.userStatus === 'BLOCK' ? 'danger' : 'secondary' %> fs-6">
            <%= userData.userStatus %>
          </span>
        </div>

        <div class="row">
          <!-- User Profile -->
          <div class="col-lg-4">
            <div class="card mb-4">
              <div class="card-body text-center">
                <img src="<%= userData.userImage || '/admin/images/default-avatar.png' %>" alt="" class="avatar-lg mb-3">
                <h4><%= userData.userNick %></h4>
                <p class="text-muted"><%= userData.userEmail %></p>
                <div class="d-flex justify-content-center gap-3 mb-3">
                  <div class="text-center">
                    <h5 class="mb-0"><%= userData.userPoints %></h5>
                    <small class="text-muted">Points</small>
                  </div>
                  <div class="text-center">
                    <h5 class="mb-0"><%= userData.userOrders?.length || 0 %></h5>
                    <small class="text-muted">Orders</small>
                  </div>
                </div>
              </div>
            </div>

            <!-- Update Status -->
            <div class="card mb-4">
              <div class="card-header">
                <i class="bi bi-gear"></i> Update Status
              </div>
              <div class="card-body">
                <form action="/admin/users/<%= userData._id %>/status" method="POST">
                  <div class="mb-3">
                    <select name="status" class="form-select">
                      <% statuses.filter(s => s !== 'DELETE').forEach(s => { %>
                        <option value="<%= s %>" <%= userData.userStatus === s ? 'selected' : '' %>><%= s %></option>
                      <% }) %>
                    </select>
                  </div>
                  <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-check-lg"></i> Update Status
                  </button>
                </form>
              </div>
            </div>

            <!-- Contact Info -->
            <div class="card">
              <div class="card-header">
                <i class="bi bi-info-circle"></i> Contact Info
              </div>
              <div class="card-body">
                <p class="mb-2"><i class="bi bi-envelope me-2"></i> <%= userData.userEmail || 'N/A' %></p>
                <p class="mb-2"><i class="bi bi-phone me-2"></i> <%= userData.userPhone %></p>
                <p class="mb-0"><i class="bi bi-calendar me-2"></i> Joined <%= new Date(userData.createdAt).toLocaleDateString() %></p>
              </div>
            </div>
          </div>

          <!-- User Details -->
          <div class="col-lg-8">
            <!-- Bio -->
            <% if (userData.userBio) { %>
              <div class="card mb-4">
                <div class="card-header">
                  <i class="bi bi-person-lines-fill"></i> Bio
                </div>
                <div class="card-body">
                  <p class="mb-0"><%= userData.userBio %></p>
                </div>
              </div>
            <% } %>

            <!-- Addresses -->
            <div class="card mb-4">
              <div class="card-header">
                <i class="bi bi-geo-alt"></i> Addresses (<%= userData.userAddresses?.length || 0 %>)
              </div>
              <div class="card-body">
                <% if (userData.userAddresses && userData.userAddresses.length > 0) { %>
                  <div class="row">
                    <% userData.userAddresses.forEach(addr => { %>
                      <div class="col-md-6 mb-3">
                        <div class="border rounded p-3 <%= addr.isDefault ? 'border-primary' : '' %>">
                          <% if (addr.isDefault) { %><span class="badge bg-primary mb-2">Default</span><% } %>
                          <% if (addr.label) { %><strong><%= addr.label %></strong><br><% } %>
                          <%= addr.street || '' %><br>
                          <%= addr.city || '' %><%= addr.state ? ', ' + addr.state : '' %> <%= addr.zipcode || '' %><br>
                          <%= addr.country || 'Uzbekistan' %>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <p class="text-muted mb-0">No addresses saved</p>
                <% } %>
              </div>
            </div>

            <!-- Recent Orders -->
            <div class="card mb-4">
              <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-cart3"></i> Recent Orders</span>
              </div>
              <div class="card-body p-0">
                <div class="table-responsive">
                  <table class="table mb-0">
                    <thead>
                      <tr>
                        <th>Order ID</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (userData.userOrders && userData.userOrders.length > 0) { %>
                        <% userData.userOrders.slice(0, 10).forEach(order => { %>
                          <tr>
                            <td>#<%= order._id.toString().slice(-6).toUpperCase() %></td>
                            <td>$<%= order.orderTotal %></td>
                            <td>
                              <span class="badge bg-<%= order.orderStatus === 'PAUSE' ? 'warning' : order.orderStatus === 'PROCESS' ? 'info' : order.orderStatus === 'FINISH' ? 'success' : 'secondary' %>">
                                <%= order.orderStatus %>
                              </span>
                            </td>
                            <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                            <td>
                              <a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i>
                              </a>
                            </td>
                          </tr>
                        <% }) %>
                      <% } else { %>
                        <tr><td colspan="5" class="text-center text-muted py-4">No orders yet</td></tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- Payment Methods -->
            <div class="card">
              <div class="card-header">
                <i class="bi bi-credit-card"></i> Payment Methods (<%= userData.userPayments?.length || 0 %>)
              </div>
              <div class="card-body">
                <% if (userData.userPayments && userData.userPayments.length > 0) { %>
                  <div class="row">
                    <% userData.userPayments.forEach(payment => { %>
                      <div class="col-md-6 mb-3">
                        <div class="border rounded p-3 <%= payment.isDefault ? 'border-primary' : '' %>">
                          <% if (payment.isDefault) { %><span class="badge bg-primary mb-2">Default</span><% } %>
                          <div class="d-flex align-items-center">
                            <i class="bi bi-credit-card fs-4 me-2"></i>
                            <div>
                              <strong><%= payment.cardName || 'Card' %></strong><br>
                              <span class="text-muted">**** **** **** <%= payment.cardNumber?.slice(-4) || '****' %></span>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <p class="text-muted mb-0">No payment methods saved</p>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </main>
      <%- include('../partials/footer') %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/admin/js/admin.js"></script>
</body>
</html>
