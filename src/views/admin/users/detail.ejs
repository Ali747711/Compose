<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Compose Coffee Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            main: '#fdd22c',
            'main-dull': '#e3b609',
            'main-duller': '#ee9b00',
            'main-text': '#2e2726',
          },
          fontFamily: {
            sans: ['Quicksand', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/admin/css/admin.css">
</head>
<body class="bg-gray-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/sidebar', { activePage }) %>

    <div class="flex-1 lg:ml-64">
      <%- include('../partials/header', { user, title }) %>

      <main class="p-6">
        <!-- Alerts -->
        <% if (success) { %>
          <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center justify-between">
            <p class="text-green-600 text-sm font-medium">User updated successfully!</p>
            <button onclick="this.parentElement.remove()" class="text-green-400 hover:text-green-600">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center justify-between">
            <p class="text-red-600 text-sm font-medium"><%= error %></p>
            <button onclick="this.parentElement.remove()" class="text-red-400 hover:text-red-600">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        <% } %>

        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
          <a href="/admin/users" class="flex items-center gap-2 text-gray-500 hover:text-main-text transition-colors">
            <i class="bi bi-arrow-left"></i> Back to Users
          </a>
          <span class="inline-flex px-4 py-1.5 rounded-full text-sm font-medium
            <%= userData.userStatus === 'ACTIVE' ? 'bg-green-50 text-green-600 border border-green-200' :
               userData.userStatus === 'BLOCK' ? 'bg-red-50 text-red-600 border border-red-200' :
               'bg-gray-50 text-gray-600 border border-gray-200' %>">
            <%= userData.userStatus %>
          </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- User Profile Sidebar -->
          <div class="space-y-6">
            <!-- Profile Card -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
              <div class="p-6 text-center">
                <img src="<%= userData.userImage || '/admin/images/default-avatar.png' %>"
                     alt=""
                     class="w-24 h-24 rounded-full object-cover mx-auto mb-4 border-4 border-main/30">
                <h4 class="text-xl font-bold text-main-text"><%= userData.userNick %></h4>
                <p class="text-gray-400 text-sm"><%= userData.userEmail %></p>
                <div class="flex justify-center gap-6 mt-4 pt-4 border-t border-gray-100">
                  <div class="text-center">
                    <p class="text-2xl font-bold text-main-text"><%= userData.userPoints %></p>
                    <p class="text-xs text-gray-400">Points</p>
                  </div>
                  <div class="text-center">
                    <p class="text-2xl font-bold text-main-text"><%= userData.userOrders?.length || 0 %></p>
                    <p class="text-xs text-gray-400">Orders</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Update Status -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
              <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                <i class="bi bi-gear text-main-dull"></i>
                <h3 class="font-semibold text-main-text">Update Status</h3>
              </div>
              <div class="p-6">
                <form action="/admin/users/<%= userData._id %>/status" method="POST">
                  <select name="status"
                          class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all mb-4">
                    <% statuses.filter(s => s !== 'DELETE').forEach(s => { %>
                      <option value="<%= s %>" <%= userData.userStatus === s ? 'selected' : '' %>><%= s %></option>
                    <% }) %>
                  </select>
                  <button type="submit"
                          class="w-full py-3 px-4 bg-main text-main-text font-bold rounded-xl border-2 border-main-dull hover:bg-main-dull transition-all duration-200 flex items-center justify-center gap-2">
                    <i class="bi bi-check-lg"></i> Update Status
                  </button>
                </form>
              </div>
            </div>

            <!-- Contact Info -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
              <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                <i class="bi bi-info-circle text-main-dull"></i>
                <h3 class="font-semibold text-main-text">Contact Info</h3>
              </div>
              <div class="p-6 space-y-3 text-sm">
                <p class="flex items-center gap-2 text-gray-600">
                  <i class="bi bi-envelope text-gray-400"></i> <%= userData.userEmail || 'N/A' %>
                </p>
                <p class="flex items-center gap-2 text-gray-600">
                  <i class="bi bi-phone text-gray-400"></i> <%= userData.userPhone %>
                </p>
                <p class="flex items-center gap-2 text-gray-600">
                  <i class="bi bi-calendar text-gray-400"></i> Joined <%= new Date(userData.createdAt).toLocaleDateString() %>
                </p>
              </div>
            </div>
          </div>

          <!-- User Details -->
          <div class="lg:col-span-2 space-y-6">
            <!-- Bio -->
            <% if (userData.userBio) { %>
              <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
                <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                  <i class="bi bi-person-lines-fill text-main-dull"></i>
                  <h3 class="font-semibold text-main-text">Bio</h3>
                </div>
                <div class="p-6">
                  <p class="text-gray-600"><%= userData.userBio %></p>
                </div>
              </div>
            <% } %>

            <!-- Addresses -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
              <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                <i class="bi bi-geo-alt text-main-dull"></i>
                <h3 class="font-semibold text-main-text">Addresses (<%= userData.userAddresses?.length || 0 %>)</h3>
              </div>
              <div class="p-6">
                <% if (userData.userAddresses && userData.userAddresses.length > 0) { %>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <% userData.userAddresses.forEach(addr => { %>
                      <div class="border rounded-xl p-4 <%= addr.isDefault ? 'border-main bg-main/5' : 'border-gray-200' %>">
                        <% if (addr.isDefault) { %><span class="inline-flex px-2 py-0.5 rounded text-xs font-medium bg-main text-main-text mb-2">Default</span><% } %>
                        <% if (addr.label) { %><p class="font-medium text-main-text"><%= addr.label %></p><% } %>
                        <p class="text-sm text-gray-600">
                          <%= addr.street || '' %><br>
                          <%= addr.city || '' %><%= addr.state ? ', ' + addr.state : '' %> <%= addr.zipcode || '' %><br>
                          <%= addr.country || 'Uzbekistan' %>
                        </p>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <p class="text-gray-400 text-sm">No addresses saved</p>
                <% } %>
              </div>
            </div>

            <!-- Recent Orders -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
              <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                <i class="bi bi-cart3 text-main-dull"></i>
                <h3 class="font-semibold text-main-text">Recent Orders</h3>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead class="bg-gray-50">
                    <tr>
                      <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Order ID</th>
                      <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Total</th>
                      <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                      <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
                      <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"></th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100">
                    <% if (userData.userOrders && userData.userOrders.length > 0) { %>
                      <% userData.userOrders.slice(0, 10).forEach(order => { %>
                        <tr class="hover:bg-gray-50 transition-colors">
                          <td class="px-6 py-4">
                            <span class="text-main-dull font-medium">#<%= order._id.toString().slice(-6).toUpperCase() %></span>
                          </td>
                          <td class="px-6 py-4 text-sm font-medium text-main-text">$<%= order.orderTotal %></td>
                          <td class="px-6 py-4">
                            <span class="inline-flex px-3 py-1 rounded-full text-xs font-medium
                              <%= order.orderStatus === 'PAUSE' ? 'bg-yellow-50 text-yellow-600 border border-yellow-200' :
                                 order.orderStatus === 'PROCESS' ? 'bg-purple-50 text-purple-600 border border-purple-200' :
                                 order.orderStatus === 'FINISH' ? 'bg-green-50 text-green-600 border border-green-200' :
                                 'bg-gray-50 text-gray-600 border border-gray-200' %>">
                              <%= order.orderStatus %>
                            </span>
                          </td>
                          <td class="px-6 py-4 text-sm text-gray-600"><%= new Date(order.createdAt).toLocaleDateString() %></td>
                          <td class="px-6 py-4">
                            <a href="/admin/orders/<%= order._id %>" class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors inline-flex">
                              <i class="bi bi-eye"></i>
                            </a>
                          </td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-gray-400">No orders yet</td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Payment Methods -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
              <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                <i class="bi bi-credit-card text-main-dull"></i>
                <h3 class="font-semibold text-main-text">Payment Methods (<%= userData.userPayments?.length || 0 %>)</h3>
              </div>
              <div class="p-6">
                <% if (userData.userPayments && userData.userPayments.length > 0) { %>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <% userData.userPayments.forEach(payment => { %>
                      <div class="border rounded-xl p-4 <%= payment.isDefault ? 'border-main bg-main/5' : 'border-gray-200' %>">
                        <% if (payment.isDefault) { %><span class="inline-flex px-2 py-0.5 rounded text-xs font-medium bg-main text-main-text mb-2">Default</span><% } %>
                        <div class="flex items-center gap-3">
                          <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center">
                            <i class="bi bi-credit-card text-gray-500"></i>
                          </div>
                          <div>
                            <p class="font-medium text-main-text"><%= payment.cardName || 'Card' %></p>
                            <p class="text-sm text-gray-400">**** **** **** <%= payment.cardNumber?.slice(-4) || '****' %></p>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <p class="text-gray-400 text-sm">No payment methods saved</p>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>

  <script src="/admin/js/admin.js"></script>
</body>
</html>
