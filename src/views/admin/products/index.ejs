<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Compose Coffee Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            main: '#fdd22c',
            'main-dull': '#e3b609',
            'main-duller': '#ee9b00',
            'main-text': '#2e2726',
          },
          fontFamily: {
            sans: ['Quicksand', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/admin/css/admin.css">
</head>
<body class="bg-gray-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/sidebar', { activePage }) %>

    <div class="flex-1 lg:ml-64">
      <%- include('../partials/header', { user, title }) %>

      <main class="p-6">
        <!-- Alerts -->
        <% if (success) { %>
          <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center justify-between">
            <p class="text-green-600 text-sm font-medium">
              <% if (success === 'created') { %>Product created successfully!
              <% } else if (success === 'updated') { %>Product updated successfully!
              <% } else if (success === 'deleted') { %>Product deleted successfully!
              <% } else { %>Operation successful.<% } %>
            </p>
            <button onclick="this.parentElement.remove()" class="text-green-400 hover:text-green-600">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center justify-between">
            <p class="text-red-600 text-sm font-medium"><%= error %></p>
            <button onclick="this.parentElement.remove()" class="text-red-400 hover:text-red-600">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        <% } %>

        <!-- Filters -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm mb-6">
          <div class="p-6">
            <form method="GET" class="grid grid-cols-1 md:grid-cols-12 gap-4">
              <div class="md:col-span-3">
                <select name="status" class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all">
                  <option value="">All Status</option>
                  <% statuses.filter(s => s !== 'DELETE').forEach(s => { %>
                    <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
              </div>
              <div class="md:col-span-3">
                <select name="collection" class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all">
                  <option value="">All Collections</option>
                  <% collections.forEach(c => { %>
                    <option value="<%= c %>" <%= filters.collection === c ? 'selected' : '' %>><%= c.replace(/_/g, ' ') %></option>
                  <% }) %>
                </select>
              </div>
              <div class="md:col-span-4">
                <input type="text" name="search" placeholder="Search products..."
                       value="<%= filters.search || '' %>"
                       class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 placeholder-gray-400 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all">
              </div>
              <div class="md:col-span-2">
                <button type="submit" class="w-full py-3 px-4 bg-main text-main-text font-bold rounded-xl border-2 border-main-dull hover:bg-main-dull transition-all duration-200 flex items-center justify-center gap-2">
                  <i class="bi bi-search"></i> Filter
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Products Table -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
          <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <i class="bi bi-cup-straw text-main-dull"></i>
              <h3 class="font-semibold text-main-text">Products (<%= products.total || 0 %>)</h3>
            </div>
            <a href="/admin/products/create" class="py-2 px-4 bg-main text-main-text font-bold rounded-xl border-2 border-main-dull hover:bg-main-dull transition-all duration-200 flex items-center gap-2 text-sm">
              <i class="bi bi-plus-lg"></i> Add Product
            </a>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Image</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Name</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Collection</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Price</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Stock</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Views</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% if (products.data && products.data.length > 0) { %>
                  <% products.data.forEach(product => { %>
                    <tr class="hover:bg-gray-50 transition-colors">
                      <td class="px-6 py-4">
                        <img src="<%= product.productImages?.[0] || '/admin/images/no-image.png' %>"
                             alt="<%= product.productName %>"
                             class="w-12 h-12 rounded-lg object-cover">
                      </td>
                      <td class="px-6 py-4 text-sm font-medium text-main-text"><%= product.productName %></td>
                      <td class="px-6 py-4">
                        <span class="inline-flex px-2 py-1 rounded-lg text-xs font-medium bg-gray-100 text-gray-600">
                          <%= product.productCollection.replace(/_/g, ' ') %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-sm font-medium text-main-text">$<%= product.productPrice %></td>
                      <td class="px-6 py-4 text-sm text-gray-600"><%= product.productLeftCount %></td>
                      <td class="px-6 py-4 text-sm text-gray-600"><%= product.productViews %></td>
                      <td class="px-6 py-4">
                        <select class="status-select px-3 py-1.5 text-xs border border-gray-200 rounded-lg focus:outline-none focus:border-main focus:ring-1 focus:ring-main/20"
                                data-id="<%= product._id %>"
                                data-type="product">
                          <% statuses.filter(s => s !== 'DELETE').forEach(s => { %>
                            <option value="<%= s %>" <%= product.productStatus === s ? 'selected' : '' %>><%= s %></option>
                          <% }) %>
                        </select>
                      </td>
                      <td class="px-6 py-4">
                        <div class="flex items-center gap-2">
                          <a href="/admin/products/<%= product._id %>/edit"
                             class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors"
                             title="Edit">
                            <i class="bi bi-pencil"></i>
                          </a>
                          <button class="delete-btn p-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors"
                                  data-id="<%= product._id %>"
                                  data-type="product"
                                  data-name="<%= product.productName %>"
                                  title="Delete">
                            <i class="bi bi-trash"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="8" class="px-6 py-12 text-center text-gray-400">
                      <i class="bi bi-inbox text-3xl block mb-2"></i>
                      No products found
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <% if (products.pages > 1) { %>
            <div class="px-6 py-4 border-t border-gray-100">
              <nav class="flex justify-center">
                <div class="flex items-center gap-1">
                  <% for (let i = 1; i <= products.pages; i++) { %>
                    <a href="?page=<%= i %>&status=<%= filters.status || '' %>&collection=<%= filters.collection || '' %>&search=<%= filters.search || '' %>"
                       class="px-4 py-2 rounded-lg text-sm font-medium transition-colors <%= products.currentPage === i ? 'bg-main text-main-text' : 'text-gray-600 hover:bg-gray-100' %>">
                      <%= i %>
                    </a>
                  <% } %>
                </div>
              </nav>
            </div>
          <% } %>
        </div>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="deleteModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50" onclick="closeDeleteModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-main-text">Confirm Delete</h3>
        <button onclick="closeDeleteModal()" class="p-2 text-gray-400 hover:text-gray-600">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <p class="text-gray-600 mb-6">Are you sure you want to delete <strong id="deleteName" class="text-main-text"></strong>?</p>
      <div class="flex items-center justify-end gap-3">
        <button onclick="closeDeleteModal()" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
          Cancel
        </button>
        <form id="deleteForm" method="POST" class="inline">
          <button type="submit" class="px-4 py-2 bg-red-500 text-white font-medium rounded-lg hover:bg-red-600 transition-colors">
            Delete
          </button>
        </form>
      </div>
    </div>
  </div>

  <script src="/admin/js/admin.js"></script>
  <script>
    // Delete modal handling
    const deleteModal = document.getElementById('deleteModal');
    const deleteForm = document.getElementById('deleteForm');
    const deleteName = document.getElementById('deleteName');

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const id = this.dataset.id;
        const type = this.dataset.type;
        const name = this.dataset.name || 'this item';

        deleteName.textContent = name;
        deleteForm.action = `/admin/${type}s/${id}/delete`;
        deleteModal.classList.remove('hidden');
      });
    });

    function closeDeleteModal() {
      deleteModal.classList.add('hidden');
    }
  </script>
</body>
</html>
