<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Compose Coffee Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/admin/css/admin.css">
</head>
<body>
  <div class="wrapper">
    <%- include('../partials/sidebar', { activePage }) %>
    <div class="main-content">
      <%- include('../partials/header', { user, title }) %>
      <main class="content">
        <% if (error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            Failed to update product. Please try again.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-pencil"></i> Edit Product</span>
            <a href="/admin/products" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-arrow-left"></i> Back to Products
            </a>
          </div>
          <div class="card-body">
            <form action="/admin/products/<%= product._id %>/update" method="POST" enctype="multipart/form-data">
              <div class="row">
                <div class="col-md-8">
                  <div class="mb-3">
                    <label for="productName" class="form-label">Product Name *</label>
                    <input type="text" class="form-control" id="productName" name="productName" value="<%= product.productName %>" required>
                  </div>

                  <div class="row">
                    <div class="col-md-4">
                      <div class="mb-3">
                        <label for="productCollection" class="form-label">Collection *</label>
                        <select class="form-select" id="productCollection" name="productCollection" required>
                          <% collections.forEach(c => { %>
                            <option value="<%= c %>" <%= product.productCollection === c ? 'selected' : '' %>><%= c.replace(/_/g, ' ') %></option>
                          <% }) %>
                        </select>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="mb-3">
                        <label for="productPrice" class="form-label">Price ($) *</label>
                        <input type="number" class="form-control" id="productPrice" name="productPrice" value="<%= product.productPrice %>" min="0" step="0.01" required>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="mb-3">
                        <label for="productStatus" class="form-label">Status</label>
                        <select class="form-select" id="productStatus" name="productStatus">
                          <% statuses.filter(s => s !== 'DELETE').forEach(s => { %>
                            <option value="<%= s %>" <%= product.productStatus === s ? 'selected' : '' %>><%= s %></option>
                          <% }) %>
                        </select>
                      </div>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-4">
                      <div class="mb-3">
                        <label for="productSize" class="form-label">Size</label>
                        <select class="form-select" id="productSize" name="productSize">
                          <% sizes.forEach(s => { %>
                            <option value="<%= s %>" <%= product.productSize === s ? 'selected' : '' %>><%= s %></option>
                          <% }) %>
                        </select>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="mb-3">
                        <label for="productVolume" class="form-label">Volume (L)</label>
                        <select class="form-select" id="productVolume" name="productVolume">
                          <% volumes.forEach(v => { %>
                            <option value="<%= v %>" <%= product.productVolume == v ? 'selected' : '' %>><%= v %>L</option>
                          <% }) %>
                        </select>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="mb-3">
                        <label for="productLeftCount" class="form-label">Stock *</label>
                        <input type="number" class="form-control" id="productLeftCount" name="productLeftCount" value="<%= product.productLeftCount %>" min="0" required>
                      </div>
                    </div>
                  </div>

                  <div class="mb-3">
                    <label for="productDesc" class="form-label">Description</label>
                    <textarea class="form-control" id="productDesc" name="productDesc" rows="4"><%= product.productDesc || '' %></textarea>
                  </div>
                </div>

                <div class="col-md-4">
                  <!-- Existing Images -->
                  <% if (product.productImages && product.productImages.length > 0) { %>
                    <div class="mb-3">
                      <label class="form-label">Current Images</label>
                      <div class="existing-images">
                        <% product.productImages.forEach((img, idx) => { %>
                          <div class="existing-image-item">
                            <img src="<%= img %>" alt="Product image">
                            <div class="form-check">
                              <input type="checkbox" class="form-check-input" name="existingImages" value="<%= img %>" id="img<%= idx %>" checked>
                              <label class="form-check-label" for="img<%= idx %>">Keep</label>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  <% } %>

                  <div class="mb-3">
                    <label for="productImages" class="form-label">Add New Images</label>
                    <input type="file" class="form-control" id="productImages" name="productImages" accept="image/*" multiple>
                    <small class="text-muted">Max 5 images total. JPEG, PNG, WEBP (10MB each)</small>
                  </div>
                  <div id="imagePreview" class="image-preview-grid"></div>

                  <div class="card bg-light mt-3">
                    <div class="card-body">
                      <h6>Product Stats</h6>
                      <p class="mb-1"><small>Views: <strong><%= product.productViews %></strong></small></p>
                      <p class="mb-1"><small>Rating: <strong><%= product.ratingsSummary?.average || 'N/A' %></strong> (<%= product.ratingsSummary?.count || 0 %> reviews)</small></p>
                      <p class="mb-0"><small>Created: <%= new Date(product.createdAt).toLocaleDateString() %></small></p>
                    </div>
                  </div>
                </div>
              </div>

              <hr>
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-check-lg"></i> Update Product
                </button>
                <a href="/admin/products" class="btn btn-outline-secondary">Cancel</a>
              </div>
            </form>
          </div>
        </div>
      </main>
      <%- include('../partials/footer') %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/admin/js/admin.js"></script>
  <script>
    // Image preview
    document.getElementById('productImages').addEventListener('change', function(e) {
      const preview = document.getElementById('imagePreview');
      preview.innerHTML = '';
      Array.from(e.target.files).forEach(file => {
        const reader = new FileReader();
        reader.onload = function(e) {
          const img = document.createElement('img');
          img.src = e.target.result;
          img.className = 'preview-image';
          preview.appendChild(img);
        };
        reader.readAsDataURL(file);
      });
    });
  </script>
</body>
</html>
