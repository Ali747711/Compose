<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Compose Coffee Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            main: '#fdd22c',
            'main-dull': '#e3b609',
            'main-duller': '#ee9b00',
            'main-text': '#2e2726',
          },
          fontFamily: {
            sans: ['Quicksand', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/admin/css/admin.css">
</head>
<body class="bg-gray-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/sidebar', { activePage }) %>

    <div class="flex-1 lg:ml-64">
      <%- include('../partials/header', { user, title }) %>

      <main class="p-6">
        <% if (error) { %>
          <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center justify-between">
            <p class="text-red-600 text-sm font-medium">Failed to update product. Please try again.</p>
            <button onclick="this.parentElement.remove()" class="text-red-400 hover:text-red-600">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        <% } %>

        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
          <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <i class="bi bi-pencil text-main-dull"></i>
              <h3 class="font-semibold text-main-text">Edit Product</h3>
            </div>
            <a href="/admin/products" class="text-sm text-gray-500 hover:text-main-text flex items-center gap-1 transition-colors">
              <i class="bi bi-arrow-left"></i> Back to Products
            </a>
          </div>

          <div class="p-6">
            <form action="/admin/products/<%= product._id %>/update" method="POST" enctype="multipart/form-data">
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Main Form -->
                <div class="lg:col-span-2 space-y-6">
                  <div>
                    <label for="productName" class="block text-sm font-medium text-gray-700 mb-2">Product Name *</label>
                    <input type="text" id="productName" name="productName" value="<%= product.productName %>" required
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all">
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                      <label for="productCollection" class="block text-sm font-medium text-gray-700 mb-2">Collection *</label>
                      <select id="productCollection" name="productCollection" required
                              class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all">
                        <% collections.forEach(c => { %>
                          <option value="<%= c %>" <%= product.productCollection === c ? 'selected' : '' %>><%= c.replace(/_/g, ' ') %></option>
                        <% }) %>
                      </select>
                    </div>
                    <div>
                      <label for="productPrice" class="block text-sm font-medium text-gray-700 mb-2">Price ($) *</label>
                      <input type="number" id="productPrice" name="productPrice" value="<%= product.productPrice %>" min="0" step="0.01" required
                             class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all">
                    </div>
                    <div>
                      <label for="productStatus" class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                      <select id="productStatus" name="productStatus"
                              class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all">
                        <% statuses.filter(s => s !== 'DELETE').forEach(s => { %>
                          <option value="<%= s %>" <%= product.productStatus === s ? 'selected' : '' %>><%= s %></option>
                        <% }) %>
                      </select>
                    </div>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                      <label for="productSize" class="block text-sm font-medium text-gray-700 mb-2">Size</label>
                      <select id="productSize" name="productSize"
                              class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all">
                        <% sizes.forEach(s => { %>
                          <option value="<%= s %>" <%= product.productSize === s ? 'selected' : '' %>><%= s %></option>
                        <% }) %>
                      </select>
                    </div>
                    <div>
                      <label for="productVolume" class="block text-sm font-medium text-gray-700 mb-2">Volume (L)</label>
                      <select id="productVolume" name="productVolume"
                              class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all">
                        <% volumes.forEach(v => { %>
                          <option value="<%= v %>" <%= product.productVolume == v ? 'selected' : '' %>><%= v %>L</option>
                        <% }) %>
                      </select>
                    </div>
                    <div>
                      <label for="productLeftCount" class="block text-sm font-medium text-gray-700 mb-2">Stock *</label>
                      <input type="number" id="productLeftCount" name="productLeftCount" value="<%= product.productLeftCount %>" min="0" required
                             class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all">
                    </div>
                  </div>

                  <div>
                    <label for="productDesc" class="block text-sm font-medium text-gray-700 mb-2">Description</label>
                    <textarea id="productDesc" name="productDesc" rows="4"
                              class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all resize-none"><%= product.productDesc || '' %></textarea>
                  </div>
                </div>

                <!-- Images & Stats -->
                <div class="space-y-6">
                  <!-- Existing Images -->
                  <% if (product.productImages && product.productImages.length > 0) { %>
                    <div>
                      <label class="block text-sm font-medium text-gray-700 mb-2">Current Images</label>
                      <div class="grid grid-cols-2 gap-2">
                        <% product.productImages.forEach((img, idx) => { %>
                          <div class="relative">
                            <img src="<%= img %>" alt="Product image" class="w-full aspect-square object-cover rounded-xl border border-gray-200">
                            <label class="absolute bottom-2 left-2 flex items-center gap-1.5 bg-white/90 backdrop-blur px-2 py-1 rounded-lg text-xs">
                              <input type="checkbox" name="existingImages" value="<%= img %>" id="img<%= idx %>" checked
                                     class="w-4 h-4 rounded border-gray-300 text-main focus:ring-main/20">
                              <span>Keep</span>
                            </label>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  <% } %>

                  <!-- Add New Images -->
                  <div>
                    <label for="productImages" class="block text-sm font-medium text-gray-700 mb-2">Add New Images</label>
                    <input type="file" id="productImages" name="productImages" accept="image/*" multiple
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-main/20 file:text-main-text hover:file:bg-main/30 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all">
                    <p class="text-xs text-gray-500 mt-1">Max 5 images total. JPEG, PNG, WEBP (10MB each)</p>
                  </div>
                  <div id="imagePreview" class="grid grid-cols-2 gap-2"></div>

                  <!-- Product Stats -->
                  <div class="bg-gray-50 rounded-xl p-4">
                    <h4 class="font-semibold text-main-text mb-3">Product Stats</h4>
                    <div class="space-y-2 text-sm">
                      <div class="flex justify-between">
                        <span class="text-gray-500">Views</span>
                        <span class="font-medium text-main-text"><%= product.productViews %></span>
                      </div>
                      <div class="flex justify-between">
                        <span class="text-gray-500">Rating</span>
                        <span class="font-medium text-main-text">
                          <%= product.ratingsSummary?.average || 'N/A' %>
                          <span class="text-gray-400">(<%= product.ratingsSummary?.count || 0 %> reviews)</span>
                        </span>
                      </div>
                      <div class="flex justify-between">
                        <span class="text-gray-500">Created</span>
                        <span class="font-medium text-main-text"><%= new Date(product.createdAt).toLocaleDateString() %></span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <hr class="my-6 border-gray-200">

              <div class="flex items-center gap-3">
                <button type="submit" class="py-3 px-6 bg-main text-main-text font-bold rounded-xl border-2 border-main-dull hover:bg-main-dull transition-all duration-200 flex items-center gap-2">
                  <i class="bi bi-check-lg"></i> Update Product
                </button>
                <a href="/admin/products" class="py-3 px-6 text-gray-600 hover:bg-gray-100 rounded-xl transition-colors">
                  Cancel
                </a>
              </div>
            </form>
          </div>
        </div>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>

  <script src="/admin/js/admin.js"></script>
  <script>
    document.getElementById('productImages').addEventListener('change', function(e) {
      const preview = document.getElementById('imagePreview');
      preview.innerHTML = '';
      Array.from(e.target.files).forEach(file => {
        const reader = new FileReader();
        reader.onload = function(e) {
          const div = document.createElement('div');
          div.className = 'relative aspect-square';
          div.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover rounded-xl border border-gray-200">`;
          preview.appendChild(div);
        };
        reader.readAsDataURL(file);
      });
    });
  </script>
</body>
</html>
