<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Compose Coffee Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/admin/css/admin.css">
</head>
<body>
  <div class="wrapper">
    <%- include('../partials/sidebar', { activePage }) %>
    <div class="main-content">
      <%- include('../partials/header', { user, title }) %>
      <main class="content">
        <% if (error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            Failed to create product. Please try again.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-plus-lg"></i> Create New Product</span>
            <a href="/admin/products" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-arrow-left"></i> Back to Products
            </a>
          </div>
          <div class="card-body">
            <form action="/admin/products/create" method="POST" enctype="multipart/form-data">
              <div class="row">
                <div class="col-md-8">
                  <div class="mb-3">
                    <label for="productName" class="form-label">Product Name *</label>
                    <input type="text" class="form-control" id="productName" name="productName" required>
                  </div>

                  <div class="row">
                    <div class="col-md-6">
                      <div class="mb-3">
                        <label for="productCollection" class="form-label">Collection *</label>
                        <select class="form-select" id="productCollection" name="productCollection" required>
                          <option value="">Select collection</option>
                          <% collections.forEach(c => { %>
                            <option value="<%= c %>"><%= c.replace(/_/g, ' ') %></option>
                          <% }) %>
                        </select>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="mb-3">
                        <label for="productPrice" class="form-label">Price ($) *</label>
                        <input type="number" class="form-control" id="productPrice" name="productPrice" min="0" step="0.01" required>
                      </div>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-4">
                      <div class="mb-3">
                        <label for="productSize" class="form-label">Size</label>
                        <select class="form-select" id="productSize" name="productSize">
                          <% sizes.forEach(s => { %>
                            <option value="<%= s %>" <%= s === 'NORMAL' ? 'selected' : '' %>><%= s %></option>
                          <% }) %>
                        </select>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="mb-3">
                        <label for="productVolume" class="form-label">Volume (L)</label>
                        <select class="form-select" id="productVolume" name="productVolume">
                          <% volumes.forEach(v => { %>
                            <option value="<%= v %>" <%= v === 1 ? 'selected' : '' %>><%= v %>L</option>
                          <% }) %>
                        </select>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="mb-3">
                        <label for="productLeftCount" class="form-label">Stock *</label>
                        <input type="number" class="form-control" id="productLeftCount" name="productLeftCount" min="0" required>
                      </div>
                    </div>
                  </div>

                  <div class="mb-3">
                    <label for="productDesc" class="form-label">Description</label>
                    <textarea class="form-control" id="productDesc" name="productDesc" rows="4"></textarea>
                  </div>
                </div>

                <div class="col-md-4">
                  <div class="mb-3">
                    <label for="productImages" class="form-label">Product Images</label>
                    <input type="file" class="form-control" id="productImages" name="productImages" accept="image/*" multiple>
                    <small class="text-muted">Max 5 images. JPEG, PNG, WEBP (10MB each)</small>
                  </div>
                  <div id="imagePreview" class="image-preview-grid"></div>
                </div>
              </div>

              <hr>
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-check-lg"></i> Create Product
                </button>
                <a href="/admin/products" class="btn btn-outline-secondary">Cancel</a>
              </div>
            </form>
          </div>
        </div>
      </main>
      <%- include('../partials/footer') %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/admin/js/admin.js"></script>
  <script>
    // Image preview
    document.getElementById('productImages').addEventListener('change', function(e) {
      const preview = document.getElementById('imagePreview');
      preview.innerHTML = '';
      Array.from(e.target.files).forEach(file => {
        const reader = new FileReader();
        reader.onload = function(e) {
          const img = document.createElement('img');
          img.src = e.target.result;
          img.className = 'preview-image';
          preview.appendChild(img);
        };
        reader.readAsDataURL(file);
      });
    });
  </script>
</body>
</html>
