<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Compose Coffee Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            main: '#fdd22c',
            'main-dull': '#e3b609',
            'main-duller': '#ee9b00',
            'main-text': '#2e2726',
          },
          fontFamily: {
            sans: ['Quicksand', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/admin/css/admin.css">
  <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
</head>
<body class="bg-gray-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/sidebar', { activePage }) %>

    <div class="flex-1 lg:ml-64">
      <%- include('../partials/header', { user, title }) %>

      <main class="p-6">
        <!-- Alerts -->
        <% if (success) { %>
          <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center justify-between">
            <p class="text-green-600 text-sm font-medium">Operation completed successfully!</p>
            <button onclick="this.parentElement.remove()" class="text-green-400 hover:text-green-600">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center justify-between">
            <p class="text-red-600 text-sm font-medium"><%= error %></p>
            <button onclick="this.parentElement.remove()" class="text-red-400 hover:text-red-600">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        <% } %>

        <!-- Stats Card -->
        <% if (adminUnreadCount > 0) { %>
          <div class="mb-6 p-4 bg-blue-50 border border-blue-200 rounded-xl">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                <i class="bi bi-envelope-fill text-blue-600"></i>
              </div>
              <div>
                <p class="text-blue-800 font-semibold">You have <%= adminUnreadCount %> unread message<%= adminUnreadCount > 1 ? 's' : '' %></p>
                <p class="text-blue-600 text-sm">Check the conversations below to respond</p>
              </div>
            </div>
          </div>
        <% } %>

        <!-- Filters -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm mb-6">
          <div class="p-6">
            <form method="GET" class="grid grid-cols-1 md:grid-cols-12 gap-4">
              <div class="md:col-span-10">
                <select name="status" class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all">
                  <option value="">All Conversations</option>
                  <% statuses.forEach(s => { %>
                    <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
              </div>
              <div class="md:col-span-2">
                <button type="submit" class="w-full py-3 px-4 bg-main text-main-text font-bold rounded-xl border-2 border-main-dull hover:bg-main-dull transition-all duration-200 flex items-center justify-center gap-2">
                  <i class="bi bi-funnel"></i> Filter
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Conversations List -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
          <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
            <i class="bi bi-chat-dots text-main-dull"></i>
            <h3 class="font-semibold text-main-text">Conversations (<%= conversations.total || 0 %>)</h3>
          </div>

          <div class="divide-y divide-gray-100">
            <% if (conversations.data && conversations.data.length > 0) { %>
              <% conversations.data.forEach(conv => { %>
                <a href="/admin/messages/<%= conv._id %>" class="block hover:bg-gray-50 transition-colors">
                  <div class="px-6 py-4">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-4">
                        <div class="relative">
                          <img src="<%= conv.userId?.userImage || '/admin/images/default-avatar.png' %>"
                               alt=""
                               class="w-12 h-12 rounded-full object-cover border-2 border-gray-200">
                          <% if (conv.unreadCount?.admin > 0) { %>
                            <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs font-bold rounded-full flex items-center justify-center">
                              <%= conv.unreadCount.admin %>
                            </span>
                          <% } %>
                        </div>
                        <div>
                          <h4 class="font-semibold text-main-text"><%= conv.userId?.userNick || 'Unknown User' %></h4>
                          <p class="text-sm text-gray-500 truncate max-w-md">
                            <%= conv.lastMessage || 'No messages yet' %>
                          </p>
                        </div>
                      </div>
                      <div class="flex items-center gap-4">
                        <div class="text-right">
                          <span class="inline-flex px-2 py-1 rounded-lg text-xs font-medium <%= conv.status === 'OPEN' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600' %>">
                            <%= conv.status %>
                          </span>
                          <p class="text-xs text-gray-400 mt-1">
                            <%= conv.lastMessageAt ? new Date(conv.lastMessageAt).toLocaleDateString() : '' %>
                          </p>
                        </div>
                        <i class="bi bi-chevron-right text-gray-400"></i>
                      </div>
                    </div>
                  </div>
                </a>
              <% }) %>
            <% } else { %>
              <div class="px-6 py-12 text-center text-gray-400">
                <i class="bi bi-chat-dots text-3xl block mb-2"></i>
                No conversations found
              </div>
            <% } %>
          </div>
        </div>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>

  <script>
    const adminSocketToken = '<%= adminSocketToken %>';

    // ============ Socket.io Setup for Real-time Updates ============
    let socket = null;

    function initializeSocket() {
      if (!adminSocketToken) {
        console.warn('No admin socket token available');
        return;
      }

      // Connect to Socket.io with admin token
      socket = io({
        auth: {
          adminToken: adminSocketToken
        }
      });

      socket.on('connect', () => {
        console.log('Admin socket connected:', socket.id);

        // Join admin dashboard room
        socket.emit('admin:join');
      });

      socket.on('connect_error', (error) => {
        console.error('Socket connection error:', error.message);
      });

      // Listen for conversation updates
      socket.on('conversation:updated', (data) => {
        console.log('Conversation updated:', data);
        updateConversationInList(data);
      });

      socket.on('disconnect', () => {
        console.log('Admin socket disconnected');
      });
    }

    // Update conversation in the list
    function updateConversationInList(data) {
      const conversationLink = document.querySelector(`a[href="/admin/messages/${data.conversationId}"]`);

      if (conversationLink) {
        // Update last message if provided
        if (data.lastMessage) {
          const lastMsgEl = conversationLink.querySelector('.truncate');
          if (lastMsgEl) {
            lastMsgEl.textContent = data.lastMessage;
          }
        }

        // Update unread badge
        if (data.unreadCount !== undefined) {
          let badge = conversationLink.querySelector('.bg-red-500');
          const avatarContainer = conversationLink.querySelector('.relative');

          if (data.unreadCount > 0) {
            if (badge) {
              badge.textContent = data.unreadCount;
            } else if (avatarContainer) {
              badge = document.createElement('span');
              badge.className = 'absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs font-bold rounded-full flex items-center justify-center';
              badge.textContent = data.unreadCount;
              avatarContainer.appendChild(badge);
            }
          } else if (badge) {
            badge.remove();
          }
        }

        // Highlight the row briefly
        conversationLink.classList.add('bg-yellow-50');
        setTimeout(() => {
          conversationLink.classList.remove('bg-yellow-50');
        }, 2000);

        // Update status badge if provided
        if (data.status) {
          const statusBadge = conversationLink.querySelector('.inline-flex.px-2.py-1');
          if (statusBadge) {
            statusBadge.textContent = data.status;
            if (data.status === 'OPEN') {
              statusBadge.className = 'inline-flex px-2 py-1 rounded-lg text-xs font-medium bg-green-100 text-green-700';
            } else {
              statusBadge.className = 'inline-flex px-2 py-1 rounded-lg text-xs font-medium bg-gray-100 text-gray-600';
            }
          }
        }
      } else {
        // New conversation - reload page to show it
        window.location.reload();
      }
    }

    // Initialize socket connection
    initializeSocket();

    // Cleanup on page unload
    window.addEventListener('beforeunload', () => {
      if (socket) {
        socket.disconnect();
      }
    });
  </script>
  <script src="/admin/js/admin.js"></script>
</body>
</html>
