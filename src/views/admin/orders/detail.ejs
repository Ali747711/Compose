<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Compose Coffee Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            main: '#fdd22c',
            'main-dull': '#e3b609',
            'main-duller': '#ee9b00',
            'main-text': '#2e2726',
          },
          fontFamily: {
            sans: ['Quicksand', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/admin/css/admin.css">
</head>
<body class="bg-gray-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/sidebar', { activePage }) %>

    <div class="flex-1 lg:ml-64">
      <%- include('../partials/header', { user, title }) %>

      <main class="p-6">
        <!-- Alerts -->
        <% if (success) { %>
          <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center justify-between">
            <p class="text-green-600 text-sm font-medium">Order updated successfully!</p>
            <button onclick="this.parentElement.remove()" class="text-green-400 hover:text-green-600">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center justify-between">
            <p class="text-red-600 text-sm font-medium"><%= error %></p>
            <button onclick="this.parentElement.remove()" class="text-red-400 hover:text-red-600">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        <% } %>

        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
          <a href="/admin/orders" class="flex items-center gap-2 text-gray-500 hover:text-main-text transition-colors">
            <i class="bi bi-arrow-left"></i> Back to Orders
          </a>
          <span class="inline-flex px-4 py-1.5 rounded-full text-sm font-medium
            <%= order.orderStatus === 'PAUSE' ? 'bg-yellow-50 text-yellow-600 border border-yellow-200' :
               order.orderStatus === 'PROCESS' ? 'bg-purple-50 text-purple-600 border border-purple-200' :
               order.orderStatus === 'FINISH' ? 'bg-green-50 text-green-600 border border-green-200' :
               'bg-gray-50 text-gray-600 border border-gray-200' %>">
            <%= order.orderStatus %>
          </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Order Details -->
          <div class="lg:col-span-2 space-y-6">
            <!-- Order Items -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
              <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                <i class="bi bi-bag text-main-dull"></i>
                <h3 class="font-semibold text-main-text">Order Items</h3>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead class="bg-gray-50">
                    <tr>
                      <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Product</th>
                      <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Quantity</th>
                      <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Price</th>
                      <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Subtotal</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100">
                    <% if (order.orderItems && order.orderItems.length > 0) { %>
                      <% order.orderItems.forEach((item, idx) => { %>
                        <% const product = order.productData?.find(p => p._id.toString() === item.productId.toString()); %>
                        <tr class="hover:bg-gray-50 transition-colors">
                          <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                              <img src="<%= product?.productImages?.[0] || '/admin/images/no-image.png' %>"
                                   alt=""
                                   class="w-12 h-12 rounded-lg object-cover border border-gray-200">
                              <div>
                                <div class="text-sm font-medium text-main-text"><%= product?.productName || 'Unknown Product' %></div>
                                <div class="text-xs text-gray-400"><%= product?.productCollection || '' %></div>
                              </div>
                            </div>
                          </td>
                          <td class="px-6 py-4 text-sm text-gray-600"><%= item.itemQuantity %></td>
                          <td class="px-6 py-4 text-sm text-gray-600">$<%= item.itemPrice %></td>
                          <td class="px-6 py-4 text-sm font-medium text-main-text">$<%= (item.itemQuantity * item.itemPrice).toFixed(2) %></td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr>
                        <td colspan="4" class="px-6 py-8 text-center text-gray-400">No items found</td>
                      </tr>
                    <% } %>
                  </tbody>
                  <tfoot class="bg-gray-50">
                    <tr>
                      <td colspan="3" class="px-6 py-3 text-right text-sm font-medium text-gray-600">Subtotal:</td>
                      <td class="px-6 py-3 text-sm text-main-text">$<%= (order.orderTotal - (order.deliveryFee || 0) - (order.tip || 0)).toFixed(2) %></td>
                    </tr>
                    <% if (order.deliveryFee) { %>
                      <tr>
                        <td colspan="3" class="px-6 py-2 text-right text-sm text-gray-500">Delivery Fee:</td>
                        <td class="px-6 py-2 text-sm text-gray-600">$<%= order.deliveryFee %></td>
                      </tr>
                    <% } %>
                    <% if (order.tip) { %>
                      <tr>
                        <td colspan="3" class="px-6 py-2 text-right text-sm text-gray-500">Tip:</td>
                        <td class="px-6 py-2 text-sm text-gray-600">$<%= order.tip %></td>
                      </tr>
                    <% } %>
                    <tr class="border-t border-gray-200">
                      <td colspan="3" class="px-6 py-4 text-right text-base font-bold text-main-text">Total:</td>
                      <td class="px-6 py-4 text-base font-bold text-main-text">$<%= order.orderTotal %></td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </div>

            <!-- Delivery Address -->
            <% if (order.orderAddress) { %>
              <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
                <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                  <i class="bi bi-geo-alt text-main-dull"></i>
                  <h3 class="font-semibold text-main-text">Delivery Address</h3>
                </div>
                <div class="p-6">
                  <% if (order.orderAddress.label) { %><p class="font-medium text-main-text mb-1"><%= order.orderAddress.label %></p><% } %>
                  <p class="text-gray-600">
                    <%= order.orderAddress.street || '' %><br>
                    <%= order.orderAddress.city || '' %><%= order.orderAddress.state ? ', ' + order.orderAddress.state : '' %> <%= order.orderAddress.zipcode || '' %><br>
                    <%= order.orderAddress.country || 'Uzbekistan' %>
                  </p>
                </div>
              </div>
            <% } %>
          </div>

          <!-- Sidebar -->
          <div class="space-y-6">
            <!-- Update Status -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
              <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                <i class="bi bi-gear text-main-dull"></i>
                <h3 class="font-semibold text-main-text">Update Status</h3>
              </div>
              <div class="p-6">
                <form action="/admin/orders/<%= order._id %>/status" method="POST">
                  <select name="status"
                          class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all mb-4">
                    <% statuses.filter(s => s !== 'DELETE').forEach(s => { %>
                      <option value="<%= s %>" <%= order.orderStatus === s ? 'selected' : '' %>><%= s %></option>
                    <% }) %>
                  </select>
                  <button type="submit"
                          class="w-full py-3 px-4 bg-main text-main-text font-bold rounded-xl border-2 border-main-dull hover:bg-main-dull transition-all duration-200 flex items-center justify-center gap-2">
                    <i class="bi bi-check-lg"></i> Update Status
                  </button>
                </form>
              </div>
            </div>

            <!-- Customer Info -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
              <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                <i class="bi bi-person text-main-dull"></i>
                <h3 class="font-semibold text-main-text">Customer</h3>
              </div>
              <div class="p-6">
                <% if (order.user) { %>
                  <div class="flex items-center gap-3 mb-4">
                    <img src="<%= order.user.userImage || '/admin/images/default-avatar.png' %>"
                         alt=""
                         class="w-12 h-12 rounded-full object-cover border-2 border-main/30">
                    <div>
                      <div class="font-medium text-main-text"><%= order.user.userNick %></div>
                      <div class="text-sm text-gray-400"><%= order.user.userEmail %></div>
                    </div>
                  </div>
                  <p class="text-sm text-gray-600 flex items-center gap-2 mb-3">
                    <i class="bi bi-phone text-gray-400"></i> <%= order.user.userPhone || 'N/A' %>
                  </p>
                  <a href="/admin/users/<%= order.user._id %>"
                     class="inline-flex items-center gap-1 text-sm text-main-dull hover:text-main-duller transition-colors">
                    View Customer <i class="bi bi-arrow-right"></i>
                  </a>
                <% } else { %>
                  <p class="text-gray-400 text-sm">Customer information not available</p>
                <% } %>
              </div>
            </div>

            <!-- Payment Info -->
            <% if (order.orderPayment) { %>
              <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
                <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                  <i class="bi bi-credit-card text-main-dull"></i>
                  <h3 class="font-semibold text-main-text">Payment</h3>
                </div>
                <div class="p-6">
                  <p class="font-medium text-main-text"><%= order.orderPayment.cardName || 'Card' %></p>
                  <p class="text-sm text-gray-400">**** **** **** <%= order.orderPayment.cardNumber?.slice(-4) || '****' %></p>
                </div>
              </div>
            <% } %>

            <!-- Order Info -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
              <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                <i class="bi bi-info-circle text-main-dull"></i>
                <h3 class="font-semibold text-main-text">Order Info</h3>
              </div>
              <div class="p-6 space-y-3 text-sm">
                <div class="flex justify-between">
                  <span class="text-gray-500">Order ID</span>
                  <span class="font-medium text-main-text text-xs break-all"><%= order._id %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-500">Created</span>
                  <span class="font-medium text-main-text"><%= new Date(order.createdAt).toLocaleString() %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-500">Updated</span>
                  <span class="font-medium text-main-text"><%= new Date(order.updatedAt).toLocaleString() %></span>
                </div>
                <% if (order.deliveryDate) { %>
                  <div class="flex justify-between">
                    <span class="text-gray-500">Delivery Date</span>
                    <span class="font-medium text-main-text"><%= order.deliveryDate %></span>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>

  <script src="/admin/js/admin.js"></script>
</body>
</html>
