<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Compose Coffee Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/admin/css/admin.css">
</head>
<body>
  <div class="wrapper">
    <%- include('../partials/sidebar', { activePage }) %>
    <div class="main-content">
      <%- include('../partials/header', { user, title }) %>
      <main class="content">
        <% if (success) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            Order updated successfully!
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <div class="d-flex justify-content-between align-items-center mb-4">
          <a href="/admin/orders" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Orders
          </a>
          <span class="badge bg-<%= order.orderStatus === 'PAUSE' ? 'warning' : order.orderStatus === 'PROCESS' ? 'info' : order.orderStatus === 'FINISH' ? 'success' : 'secondary' %> fs-6">
            <%= order.orderStatus %>
          </span>
        </div>

        <div class="row">
          <!-- Order Details -->
          <div class="col-lg-8">
            <div class="card mb-4">
              <div class="card-header">
                <i class="bi bi-bag"></i> Order Items
              </div>
              <div class="card-body p-0">
                <div class="table-responsive">
                  <table class="table mb-0">
                    <thead>
                      <tr>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Subtotal</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (order.orderItems && order.orderItems.length > 0) { %>
                        <% order.orderItems.forEach((item, idx) => { %>
                          <% const product = order.productData?.find(p => p._id.toString() === item.productId.toString()); %>
                          <tr>
                            <td>
                              <div class="d-flex align-items-center">
                                <img src="<%= product?.productImages?.[0] || '/admin/images/no-image.png' %>" alt="" class="product-thumb me-2">
                                <div>
                                  <div><%= product?.productName || 'Unknown Product' %></div>
                                  <small class="text-muted"><%= product?.productCollection || '' %></small>
                                </div>
                              </div>
                            </td>
                            <td><%= item.itemQuantity %></td>
                            <td>$<%= item.itemPrice %></td>
                            <td>$<%= (item.itemQuantity * item.itemPrice).toFixed(2) %></td>
                          </tr>
                        <% }) %>
                      <% } else { %>
                        <tr><td colspan="4" class="text-center text-muted">No items found</td></tr>
                      <% } %>
                    </tbody>
                    <tfoot>
                      <tr>
                        <td colspan="3" class="text-end"><strong>Subtotal:</strong></td>
                        <td>$<%= (order.orderTotal - (order.deliveryFee || 0) - (order.tip || 0)).toFixed(2) %></td>
                      </tr>
                      <% if (order.deliveryFee) { %>
                        <tr>
                          <td colspan="3" class="text-end">Delivery Fee:</td>
                          <td>$<%= order.deliveryFee %></td>
                        </tr>
                      <% } %>
                      <% if (order.tip) { %>
                        <tr>
                          <td colspan="3" class="text-end">Tip:</td>
                          <td>$<%= order.tip %></td>
                        </tr>
                      <% } %>
                      <tr class="table-active">
                        <td colspan="3" class="text-end"><strong>Total:</strong></td>
                        <td><strong>$<%= order.orderTotal %></strong></td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
              </div>
            </div>

            <!-- Delivery Address -->
            <% if (order.orderAddress) { %>
              <div class="card mb-4">
                <div class="card-header">
                  <i class="bi bi-geo-alt"></i> Delivery Address
                </div>
                <div class="card-body">
                  <% if (order.orderAddress.label) { %><strong><%= order.orderAddress.label %></strong><br><% } %>
                  <%= order.orderAddress.street || '' %><br>
                  <%= order.orderAddress.city || '' %><%= order.orderAddress.state ? ', ' + order.orderAddress.state : '' %> <%= order.orderAddress.zipcode || '' %><br>
                  <%= order.orderAddress.country || 'Uzbekistan' %>
                </div>
              </div>
            <% } %>
          </div>

          <!-- Sidebar -->
          <div class="col-lg-4">
            <!-- Update Status -->
            <div class="card mb-4">
              <div class="card-header">
                <i class="bi bi-gear"></i> Update Status
              </div>
              <div class="card-body">
                <form action="/admin/orders/<%= order._id %>/status" method="POST">
                  <div class="mb-3">
                    <select name="status" class="form-select">
                      <% statuses.filter(s => s !== 'DELETE').forEach(s => { %>
                        <option value="<%= s %>" <%= order.orderStatus === s ? 'selected' : '' %>><%= s %></option>
                      <% }) %>
                    </select>
                  </div>
                  <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-check-lg"></i> Update Status
                  </button>
                </form>
              </div>
            </div>

            <!-- Customer Info -->
            <div class="card mb-4">
              <div class="card-header">
                <i class="bi bi-person"></i> Customer
              </div>
              <div class="card-body">
                <% if (order.user) { %>
                  <div class="d-flex align-items-center mb-3">
                    <img src="<%= order.user.userImage || '/admin/images/default-avatar.png' %>" alt="" class="avatar me-3">
                    <div>
                      <strong><%= order.user.userNick %></strong>
                      <div class="text-muted small"><%= order.user.userEmail %></div>
                    </div>
                  </div>
                  <p class="mb-1"><i class="bi bi-phone"></i> <%= order.user.userPhone || 'N/A' %></p>
                  <a href="/admin/users/<%= order.user._id %>" class="btn btn-outline-primary btn-sm mt-2">
                    View Customer
                  </a>
                <% } else { %>
                  <p class="text-muted">Customer information not available</p>
                <% } %>
              </div>
            </div>

            <!-- Payment Info -->
            <% if (order.orderPayment) { %>
              <div class="card mb-4">
                <div class="card-header">
                  <i class="bi bi-credit-card"></i> Payment
                </div>
                <div class="card-body">
                  <p class="mb-1"><strong><%= order.orderPayment.cardName || 'Card' %></strong></p>
                  <p class="mb-0 text-muted">**** **** **** <%= order.orderPayment.cardNumber?.slice(-4) || '****' %></p>
                </div>
              </div>
            <% } %>

            <!-- Order Info -->
            <div class="card">
              <div class="card-header">
                <i class="bi bi-info-circle"></i> Order Info
              </div>
              <div class="card-body">
                <p class="mb-1"><strong>Order ID:</strong> <%= order._id %></p>
                <p class="mb-1"><strong>Created:</strong> <%= new Date(order.createdAt).toLocaleString() %></p>
                <p class="mb-1"><strong>Updated:</strong> <%= new Date(order.updatedAt).toLocaleString() %></p>
                <% if (order.deliveryDate) { %>
                  <p class="mb-0"><strong>Delivery Date:</strong> <%= order.deliveryDate %></p>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </main>
      <%- include('../partials/footer') %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/admin/js/admin.js"></script>
</body>
</html>
