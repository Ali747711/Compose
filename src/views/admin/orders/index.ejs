<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Compose Coffee Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            main: '#fdd22c',
            'main-dull': '#e3b609',
            'main-duller': '#ee9b00',
            'main-text': '#2e2726',
          },
          fontFamily: {
            sans: ['Quicksand', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/admin/css/admin.css">
</head>
<body class="bg-gray-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/sidebar', { activePage }) %>

    <div class="flex-1 lg:ml-64">
      <%- include('../partials/header', { user, title }) %>

      <main class="p-6">
        <!-- Alerts -->
        <% if (success) { %>
          <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center justify-between">
            <p class="text-green-600 text-sm font-medium">Order status updated successfully!</p>
            <button onclick="this.parentElement.remove()" class="text-green-400 hover:text-green-600">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center justify-between">
            <p class="text-red-600 text-sm font-medium"><%= error %></p>
            <button onclick="this.parentElement.remove()" class="text-red-400 hover:text-red-600">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        <% } %>

        <!-- Filters -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm mb-6">
          <div class="p-6">
            <form method="GET" class="flex flex-wrap gap-4">
              <div class="flex-1 min-w-[200px]">
                <select name="status" class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all">
                  <option value="">All Status</option>
                  <% statuses.filter(s => s !== 'DELETE').forEach(s => { %>
                    <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
              </div>
              <button type="submit" class="py-3 px-6 bg-main text-main-text font-bold rounded-xl border-2 border-main-dull hover:bg-main-dull transition-all duration-200 flex items-center gap-2">
                <i class="bi bi-search"></i> Filter
              </button>
            </form>
          </div>
        </div>

        <!-- Orders Table -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
          <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
            <i class="bi bi-cart3 text-main-dull"></i>
            <h3 class="font-semibold text-main-text">Orders (<%= orders.total || 0 %>)</h3>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Order ID</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Customer</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Items</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Total</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% if (orders.data && orders.data.length > 0) { %>
                  <% orders.data.forEach(order => { %>
                    <tr class="hover:bg-gray-50 transition-colors">
                      <td class="px-6 py-4">
                        <a href="/admin/orders/<%= order._id %>" class="text-main-dull hover:text-main-duller font-bold">
                          #<%= order._id.toString().slice(-6).toUpperCase() %>
                        </a>
                      </td>
                      <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                          <img src="<%= order.user?.userImage || '/admin/images/default-avatar.png' %>"
                               alt=""
                               class="w-10 h-10 rounded-full object-cover border border-gray-200">
                          <div>
                            <div class="text-sm font-medium text-main-text"><%= order.user?.userNick || 'N/A' %></div>
                            <div class="text-xs text-gray-400"><%= order.user?.userEmail || '' %></div>
                          </div>
                        </div>
                      </td>
                      <td class="px-6 py-4 text-sm text-gray-600"><%= order.orderItems?.length || 0 %> items</td>
                      <td class="px-6 py-4 text-sm font-medium text-main-text">$<%= order.orderTotal %></td>
                      <td class="px-6 py-4 text-sm text-gray-600"><%= new Date(order.createdAt).toLocaleDateString() %></td>
                      <td class="px-6 py-4">
                        <select class="status-select px-3 py-1.5 text-xs border border-gray-200 rounded-lg focus:outline-none focus:border-main focus:ring-1 focus:ring-main/20"
                                data-id="<%= order._id %>"
                                data-type="order">
                          <% statuses.filter(s => s !== 'DELETE').forEach(s => { %>
                            <option value="<%= s %>" <%= order.orderStatus === s ? 'selected' : '' %>><%= s %></option>
                          <% }) %>
                        </select>
                      </td>
                      <td class="px-6 py-4">
                        <a href="/admin/orders/<%= order._id %>"
                           class="inline-flex items-center gap-1 px-3 py-1.5 text-sm text-blue-600 hover:bg-blue-50 rounded-lg transition-colors">
                          <i class="bi bi-eye"></i> View
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="px-6 py-12 text-center text-gray-400">
                      <i class="bi bi-inbox text-3xl block mb-2"></i>
                      No orders found
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <% if (orders.pages > 1) { %>
            <div class="px-6 py-4 border-t border-gray-100">
              <nav class="flex justify-center">
                <div class="flex items-center gap-1">
                  <% for (let i = 1; i <= orders.pages; i++) { %>
                    <a href="?page=<%= i %>&status=<%= filters.status || '' %>"
                       class="px-4 py-2 rounded-lg text-sm font-medium transition-colors <%= orders.currentPage === i ? 'bg-main text-main-text' : 'text-gray-600 hover:bg-gray-100' %>">
                      <%= i %>
                    </a>
                  <% } %>
                </div>
              </nav>
            </div>
          <% } %>
        </div>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>

  <script src="/admin/js/admin.js"></script>
</body>
</html>
