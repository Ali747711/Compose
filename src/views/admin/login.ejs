<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Compose Coffee</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            main: '#fdd22c',
            'main-dull': '#e3b609',
            'main-duller': '#ee9b00',
            'main-text': '#2e2726',
          },
          fontFamily: {
            sans: ['Quicksand', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="min-h-screen bg-gradient-to-br from-main-text via-gray-900 to-main-text flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-2xl shadow-xl p-8 md:p-10">
      <!-- Logo Header -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-main/20 rounded-2xl mb-4">
          <i class="bi bi-cup-hot-fill text-3xl text-main-dull"></i>
        </div>
        <h1 class="text-2xl font-bold text-main-text">Compose Coffee</h1>
        <p class="text-gray-500 text-sm mt-1">Admin Panel</p>
      </div>

      <!-- Error Alert -->
      <% if (error) { %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl">
          <p class="text-red-600 text-sm font-medium">
            <% if (error === 'invalid_credentials') { %>
              Invalid username or password
            <% } else if (error === 'unauthorized') { %>
              You are not authorized to access this area
            <% } else if (error === 'admin_exists') { %>
              Admin account already exists. Please login.
            <% } else if (error === 'session_error') { %>
              Session expired. Please login again.
            <% } else { %>
              An error occurred. Please try again.
            <% } %>
          </p>
        </div>
      <% } %>

      <!-- Success Alert -->
      <% if (success) { %>
        <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl">
          <p class="text-green-600 text-sm font-medium">
            <% if (success === 'logout') { %>
              You have been logged out successfully.
            <% } else if (success === 'account_created') { %>
              Admin account created successfully! Please login.
            <% } else { %>
              Operation successful.
            <% } %>
          </p>
        </div>
      <% } %>

      <!-- Login Form -->
      <form action="/admin/login" method="POST" class="space-y-5">
        <div>
          <label for="userNick" class="block text-sm font-medium text-gray-700 mb-2">Username</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
              <i class="bi bi-person"></i>
            </span>
            <input
              type="text"
              id="userNick"
              name="userNick"
              placeholder="Enter your username"
              required
              class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl text-gray-700 placeholder-gray-400 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all"
            >
          </div>
        </div>

        <div>
          <label for="userPassword" class="block text-sm font-medium text-gray-700 mb-2">Password</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
              <i class="bi bi-lock"></i>
            </span>
            <input
              type="password"
              id="userPassword"
              name="userPassword"
              placeholder="Enter your password"
              required
              class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-xl text-gray-700 placeholder-gray-400 focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 transition-all"
            >
          </div>
        </div>

        <button
          type="submit"
          class="w-full py-3 px-4 bg-main text-main-text font-bold rounded-xl border-2 border-main-dull hover:bg-main-dull transition-all duration-200 flex items-center justify-center gap-2 shadow-sm hover:shadow-md"
        >
          <i class="bi bi-box-arrow-in-right"></i>
          Login
        </button>
      </form>

      <!-- Create Admin Link -->
      <% if (!adminExists) { %>
        <div class="mt-8 pt-6 border-t border-gray-200 text-center">
          <p class="text-gray-500 text-sm mb-3">No admin account yet?</p>
          <a
            href="/admin/signup"
            class="inline-flex items-center gap-2 px-5 py-2.5 border border-gray-200 rounded-xl text-gray-600 hover:border-main/50 hover:bg-gray-50 transition-all text-sm font-medium"
          >
            <i class="bi bi-person-plus"></i>
            Create Admin Account
          </a>
        </div>
      <% } %>
    </div>

    <!-- Footer -->
    <p class="text-center text-gray-400 text-xs mt-6">
      &copy; <%= new Date().getFullYear() %> Compose Coffee. All rights reserved.
    </p>
  </div>
</body>
</html>
