<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Compose Coffee</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/admin/css/admin.css">
</head>
<body class="login-page">
  <div class="login-container">
    <div class="login-card">
      <div class="login-header">
        <h1><i class="bi bi-cup-hot-fill"></i> Compose Coffee</h1>
        <p>Admin Panel</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger">
          <% if (error === 'invalid_credentials') { %>
            Invalid username or password
          <% } else if (error === 'unauthorized') { %>
            You are not authorized to access this area
          <% } else if (error === 'admin_exists') { %>
            Admin account already exists. Please login.
          <% } else if (error === 'session_error') { %>
            Session expired. Please login again.
          <% } else { %>
            An error occurred. Please try again.
          <% } %>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success">
          <% if (success === 'logout') { %>
            You have been logged out successfully.
          <% } else if (success === 'account_created') { %>
            Admin account created successfully! Please login.
          <% } else { %>
            Operation successful.
          <% } %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST">
        <div class="mb-3">
          <label for="userNick" class="form-label">Username</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-person"></i></span>
            <input type="text" class="form-control" id="userNick" name="userNick" placeholder="Enter your username" required>
          </div>
        </div>
        <div class="mb-3">
          <label for="userPassword" class="form-label">Password</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input type="password" class="form-control" id="userPassword" name="userPassword" placeholder="Enter your password" required>
          </div>
        </div>
        <button type="submit" class="btn btn-primary w-100">
          <i class="bi bi-box-arrow-in-right"></i> Login
        </button>
      </form>

      <% if (!adminExists) { %>
        <div class="mt-4 text-center">
          <p class="text-muted">No admin account yet?</p>
          <a href="/admin/signup" class="btn btn-outline-secondary">
            <i class="bi bi-person-plus"></i> Create Admin Account
          </a>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
