<header class="admin-header">
  <div class="header-left">
    <button class="sidebar-toggle d-lg-none" id="sidebarToggle">
      <i class="bi bi-list"></i>
    </button>
    <h1 class="page-title"><%= title %></h1>
  </div>
  <div class="header-right">
    <div class="dropdown">
      <button class="btn dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown">
        <img src="<%= user.userImage || '/admin/images/default-avatar.png' %>" alt="Avatar" class="avatar">
        <span class="d-none d-md-inline ms-2"><%= user.userNick %></span>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><span class="dropdown-item-text text-muted small"><%= user.userEmail %></span></li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <a class="dropdown-item text-danger" href="/admin/logout">
            <i class="bi bi-box-arrow-right"></i> Logout
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>
